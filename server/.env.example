YOUTUBE_API_KEY=your_youtube_data_api_v3_key

# ---------------------------------------------------------------------------
# Runtime (Phase 19)
# ---------------------------------------------------------------------------
# NODE_ENV=production enables Secure session cookies. Required in production.
NODE_ENV=
# HTTP port for the API server (default 4000).
PORT=
# YouTube live-chat polling interval in ms (minimum 2000, default 8000).
YOUTUBE_POLL_MS=
# SQLite database file override. Defaults to server/data/falfoos.db
DB_PATH=

# Admin authorization (Phase 9A). If unset, the server generates an ephemeral
# token per boot and prints it to the console. Set this in production.
ADMIN_TOKEN=

# SQLite database file (Phase 11B). Defaults to server/data/falfoos.db
DB_PATH=

# ---------------------------------------------------------------------------
# Google OAuth (Phase 11C) — OPTIONAL. Sign-in stays disabled until all three
# GOOGLE_* values are set. Credentials are SERVER-ONLY: never expose them to
# the client bundle, never commit them (.env is gitignored).
#
# 1. Create an OAuth client of type "Web application" in Google Cloud Console.
# 2. Authorized redirect URI must EXACTLY match GOOGLE_REDIRECT_URI.
#    Development example:
#      http://localhost:4000/api/auth/google/callback
#    PRODUCTION (Phase 19 canonical values — frontend on Vercel):
#      APP_BASE_URL=https://falfoos.vercel.app
#      GOOGLE_REDIRECT_URI=https://falfoos.vercel.app/api/auth/google/callback
#    The redirect URI may alternatively be derived from APP_BASE_URL.
# 3. Login scopes are openid/email/profile only ? no YouTube scopes.
# NODE_ENV=production additionally enables Secure cookies for HTTPS deploys.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
APP_BASE_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# First-admin bootstrap (Phase 11F) — OPTIONAL. Comma-separated list of Google
# account emails; on login, a matching verified email is granted role=admin
# (upgrade-only — existing admins are never demoted). Leave unset to manage
# admin roles manually in the database. ADMIN_TOKEN remains the break-glass
# fallback either way.
# ---------------------------------------------------------------------------
ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# Phase 3 — Bot webhook HMAC secret (bot -> website purchase events).
# Shared secret used to VERIFY the bot's signed purchase-event webhooks. It must
# match the bot's BOT_WEBHOOK_SECRET. Generate a secure random string (32+ bytes
# hex). SERVER-ONLY: never expose it to the client bundle, never commit it
# (.env is gitignored). Replace the placeholder with a real random value.
BOT_WEBHOOK_SECRET=replace_with_bot_webhook_hmac_secret

# ---------------------------------------------------------------------------
# Phase 7 — Website <-> Bot integration (account linking + ticket purchase).
# WEBSITE_INTEGRATION_SECRET is a SEPARATE shared secret used for the
# website -> bot requests AND for verifying the bot's signed responses. It must
# match the bot's WEBSITE_INTEGRATION_SECRET. SERVER-ONLY: never expose it to
# the client bundle, never commit it (.env is gitignored). Replace the
# placeholder with a real random value.
WEBSITE_INTEGRATION_SECRET=replace_with_website_integration_shared_secret
# FALFOOS_BOT_URL is the base URL of the bot integration server (no trailing
# slash). Example: http://127.0.0.1:8787
FALFOOS_BOT_URL=http://127.0.0.1:8787
